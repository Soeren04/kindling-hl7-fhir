{
  "$schema": "https://unpkg.com/knip@6.40.0/schema.json",
  "ignoreBinaries": ["go", "pipx"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "tooling/*.test.ts", "scripts/*.test.ts"],
      "project": ["*.{js,mjs,ts}", "scripts/**", "tooling/**"],
      "ignore": ["tooling/fixtures/**"]
    },
    "packages/hl7-to-fhir": {
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "entry": [
        "test/**/*.test.ts",
        "test/**/*.test-d.ts",
        "test/type-perf/paths.ts"
      ],
      "vitest": false
    }
  }
}
