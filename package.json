{
  "name": "hl7-to-fhir-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm --filter hl7-to-fhir run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -p tsconfig.json && pnpm --recursive run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "pnpm build && vitest bench --config packages/hl7-to-fhir/bench/bench.config.ts",
    "bench:memory": "pnpm build && vitest run --config packages/hl7-to-fhir/bench/bench.config.ts",
    "depcruise": "depcruise packages/hl7-to-fhir/src --config .dependency-cruiser.mjs",
    "knip": "knip --treat-config-hints-as-errors",
    "check:package": "pnpm --filter hl7-to-fhir run check:package",
    "check:type-performance": "pnpm --filter hl7-to-fhir run check:type-performance",
    "check:api": "pnpm --filter hl7-to-fhir run check:api",
    "update:api": "pnpm build && pnpm --filter hl7-to-fhir run update:api",
    "verify:fast": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "verify:ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm depcruise && pnpm knip && pnpm check:type-performance && pnpm build && pnpm check:api && pnpm check:package",
    "verify": "pnpm verify:ci && pnpm lint:workflows",
    "lint:workflows": "go run github.com/rhysd/actionlint/cmd/actionlint@v1.7.12 && pipx run zizmor==1.30.1 ."
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@fast-check/vitest": "0.5.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-tsdoc": "0.5.4",
    "fast-check": "4.10.2",
    "knip": "6.40.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
