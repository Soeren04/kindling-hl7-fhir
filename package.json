{
  "name": "hl7-to-fhir-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && pnpm --recursive run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify:fast": "pnpm format:check && pnpm typecheck && pnpm test",
    "verify": "pnpm format:check && pnpm typecheck && pnpm test:coverage"
  },
  "devDependencies": {
    "@fast-check/vitest": "0.5.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
