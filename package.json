{
  "name": "hl7-to-fhir-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm --filter hl7-to-fhir run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -p tsconfig.json && pnpm --recursive run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "depcruise": "depcruise packages/hl7-to-fhir/src --config .dependency-cruiser.mjs",
    "knip": "knip --treat-config-hints-as-errors",
    "check:package": "pnpm --filter hl7-to-fhir run check:package",
    "verify:fast": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm depcruise && pnpm knip && pnpm build && pnpm check:package"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@fast-check/vitest": "0.5.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-tsdoc": "0.5.4",
    "fast-check": "4.10.2",
    "knip": "6.40.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
